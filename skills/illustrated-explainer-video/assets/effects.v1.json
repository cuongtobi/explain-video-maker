{
  "version": "1.0",
  "effects": {
    "static": {
      "target": "camera",
      "phase": "hold",
      "kind": "static"
    },
    "slow_push": {
      "target": "camera",
      "phase": "hold",
      "kind": "transform",
      "duration": "full",
      "from": { "scale": 1.0, "x_percent": 0, "y_percent": 0 },
      "to": { "scale": 1.06, "x_percent": 0, "y_percent": 0 },
      "ease": "none"
    },
    "medium_push": {
      "target": "camera",
      "phase": "hold",
      "kind": "transform",
      "duration": "full",
      "from": { "scale": 1.0 },
      "to": { "scale": 1.12 },
      "ease": "power1.inOut"
    },
    "slow_pull": {
      "target": "camera",
      "phase": "hold",
      "kind": "transform",
      "duration": "full",
      "from": { "scale": 1.08 },
      "to": { "scale": 1.0 },
      "ease": "none"
    },
    "pan_left": {
      "target": "camera",
      "phase": "hold",
      "kind": "transform",
      "duration": "full",
      "from": { "x_percent": 2 },
      "to": { "x_percent": -2 },
      "ease": "none"
    },
    "pan_right": {
      "target": "camera",
      "phase": "hold",
      "kind": "transform",
      "duration": "full",
      "from": { "x_percent": -2 },
      "to": { "x_percent": 2 },
      "ease": "none"
    },
    "detail_zoom": {
      "target": "camera",
      "phase": "hold",
      "kind": "focus-transform",
      "duration": "full",
      "from": { "scale": 1.0 },
      "to": { "scale": 1.22 },
      "ease": "power1.inOut"
    },
    "fade_in": {
      "target": "asset",
      "phase": "enter",
      "kind": "opacity",
      "duration": 0.35,
      "from": { "opacity": 0 },
      "to": { "opacity": 1 },
      "ease": "power1.out"
    },
    "slide_left": {
      "target": "asset",
      "phase": "enter",
      "kind": "transform",
      "duration": 0.45,
      "from": { "x_percent": -12, "opacity": 0 },
      "to": { "x_percent": 0, "opacity": 1 },
      "ease": "power3.out"
    },
    "slide_right": {
      "target": "asset",
      "phase": "enter",
      "kind": "transform",
      "duration": 0.45,
      "from": { "x_percent": 12, "opacity": 0 },
      "to": { "x_percent": 0, "opacity": 1 },
      "ease": "power3.out"
    },
    "slide_up": {
      "target": "asset",
      "phase": "enter",
      "kind": "transform",
      "duration": 0.42,
      "from": { "y_percent": 10, "opacity": 0 },
      "to": { "y_percent": 0, "opacity": 1 },
      "ease": "power3.out"
    },
    "pop_in": {
      "target": "asset",
      "phase": "enter",
      "kind": "transform",
      "duration": 0.3,
      "from": { "scale": 0.82, "opacity": 0 },
      "to": { "scale": 1.0, "opacity": 1 },
      "ease": "back.out(1.4)"
    },
    "micro_float": {
      "target": "asset",
      "phase": "hold",
      "kind": "transform",
      "duration": "full",
      "from": { "y": 0 },
      "to": { "y": -5 },
      "ease": "sine.inOut",
      "yoyo": true,
      "finite": true
    },
    "measurement_reveal": {
      "target": "overlay",
      "phase": "enter",
      "kind": "reveal",
      "duration": 0.45,
      "ease": "power2.out"
    },
    "highlight_pulse": {
      "target": "overlay",
      "phase": "emphasis",
      "kind": "scale",
      "duration": 0.28,
      "from": { "scale": 1.0 },
      "to": { "scale": 1.05 },
      "ease": "power2.out",
      "finite": true
    },
    "fade_out": {
      "target": "asset",
      "phase": "exit",
      "kind": "opacity",
      "duration": 0.25,
      "from": { "opacity": 1 },
      "to": { "opacity": 0 },
      "ease": "power1.in"
    }
  },
  "transitions": ["cut", "fade", "slide"]
}
